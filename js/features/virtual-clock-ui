/**
 * virtual-clock-ui.js - 虚拟时钟弹窗 UI
 * 包含：时刻弹窗 + 流速修改弹窗
 */

(function() {
    'use strict';

    // 弹窗 ID
    const MODAL_IDS = {
        TIME_MODAL: 'vc-time-modal',
        SPEED_MODAL: 'vc-speed-modal',
    };

    // ============================================================
    // 工具函数
    // ============================================================

    function getPartnerName() {
        const settings = window.settings || {};
        return settings.partnerName || '对方';
    }

    function getMyName() {
        const settings = window.settings || {};
        return settings.myName || '我';
    }

    function getRealTimeStr() {
        const now = new Date();
        return String(now.getHours()).padStart(2, '0') + ':' +
               String(now.getMinutes()).padStart(2, '0') + ':' +
               String(now.getSeconds()).padStart(2, '0');
    }

    function escapeHtml(str) {
        if (!str) return '';
        return String(str).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
    }

    // ============================================================
    // 系统消息（插入聊天）
    // ============================================================

    /**
     * 插入虚拟时钟操作的系统消息
     * @param {string} text - 消息内容
     * @param {string} emoji - 表情符号
     * @param {string} status - 'waiting' | 'success' | 'fail' | 'info'
     */
    function insertVirtualClockMessage(text, emoji, status) {
        if (typeof window.addMessage !== 'function') {
            console.warn('[vc-ui] addMessage 不可用');
            return;
        }

        let finalText = text;
        if (emoji) {
            finalText = emoji + ' ' + text;
        }

        // 如果是等待状态，添加动画点
        if (status === 'waiting') {
            finalText += ' <span class="vc-waiting-dots">· · ·</span>';
        }

        // 查找或创建系统消息容器
        const container = document.getElementById('chat-container');
        if (!container) return;

        // 直接使用 addMessage 添加系统消息
        window.addMessage({
            id: Date.now() + '_vc_' + Math.random().toString(36).slice(2, 6),
            sender: null,
            text: finalText,
            timestamp: new Date(),
            type: 'system',
            _vcStatus: status,
            _vcEmoji: emoji,
            _vcRawText: text,
        });
    }

    /**
     * 更新最后一条系统消息的状态（用于等待→成功/失败）
     * 因为系统消息已保留在聊天中，我们直接添加新消息来表示状态变化
     */
    function appendVirtualClockResult(text, emoji, status) {
        // 直接插入新的系统消息
        insertVirtualClockMessage(text, emoji, status);
    }

    /**
     * 发送等待状态消息
     */
    function sendWaitingMessage(action) {
        const label = action === 'time' ? '申请修改时间' : '申请修改流速';
        insertVirtualClockMessage('我' + label, '✦', 'waiting');
    }

    /**
     * 发送成功消息
     */
    function sendSuccessMessage(action, value) {
        const settings = window.settings || {};
        const partnerName = settings.partnerName || '对方';
        let text = '';
        let emoji = '';

        if (action === 'time') {
            text = partnerName + '修改了时间';
            emoji = '✨';
            insertVirtualClockMessage(text, emoji, 'success');
        } else if (action === 'speed') {
            text = partnerName + '修改了流速';
            emoji = '⚡';
            insertVirtualClockMessage(text, emoji, 'success');
        } else if (action === 'save-speed') {
            text = '流速已更新';
            emoji = '⚡';
            insertVirtualClockMessage(text, emoji, 'success');
        }
    }

    /**
     * 发送失败消息
     */
    function sendFailMessage(action) {
        const settings = window.settings || {};
        const partnerName = settings.partnerName || '对方';
        const text = partnerName + '拒绝了请求';
        const emoji = '💫';
        insertVirtualClockMessage(text, emoji, 'fail');
    }

    // ============================================================
    // 创建【时刻】弹窗
    // ============================================================

    function createTimeModal() {
        // 如果已存在，直接显示
        let modal = document.getElementById(MODAL_IDS.TIME_MODAL);
        if (modal) {
            modal.style.display = 'flex';
            updateTimeModalContent();
            return;
        }

        modal = document.createElement('div');
        modal.id = MODAL_IDS.TIME_MODAL;
        modal.className = 'vc-modal vc-time-modal';
        modal.style.cssText = `
            display: flex;
            position: fixed;
            inset: 0;
            z-index: 9999;
            background: rgba(0,0,0,0.55);
            backdrop-filter: blur(8px);
            -webkit-backdrop-filter: blur(8px);
